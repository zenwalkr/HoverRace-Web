{
  "name": "hoverrace-web-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node tools/convert-assets.mjs",
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "server": "php -S 127.0.0.1:8081 -t server/public server/public/index.php",
    "serve": "php -S 0.0.0.0:8081 -t server/public server/public/index.php",
    "build": "npm run assets && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test:physics": "node --test tests/physics.test.js",
    "test:procedural": "node --test tests/procedural.test.js",
    "test:server": "node tests/server.test.mjs",
    "test:production": "npm run build && node tests/production.test.mjs",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.3"
  }
}
